#!/usr/bin/env python3
"""Small allowlisted gesture receiver for the logged-in Hyprland user."""
import json
import os
from pathlib import Path
import subprocess
import sys

ACTIONS = {'left','right','up','down','launcher','desktop','show-desktop','restore-desktop'}
def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ACTIONS:
        raise SystemExit('Expected left/right/up/down/launcher/desktop/show-desktop/restore-desktop')
    os.environ.setdefault('XDG_RUNTIME_DIR', '/run/user/%d' % os.getuid())
    os.environ.setdefault('OMARCHY_PATH', '/usr/share/omarchy')
    os.environ.setdefault('DBUS_SESSION_BUS_ADDRESS', 'unix:path=' + os.environ['XDG_RUNTIME_DIR'] + '/bus')
    os.environ['PATH'] = os.environ['OMARCHY_PATH'] + '/bin:' + os.environ.get('PATH', '/usr/bin:/bin')
    if not os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'):
        instances = json.loads(subprocess.check_output(['/usr/bin/hyprctl','instances','-j']))
        if len(instances) != 1:
            raise SystemExit('Expected exactly one Hyprland session')
        os.environ['HYPRLAND_INSTANCE_SIGNATURE'] = instances[0]['instance']
        os.environ['WAYLAND_DISPLAY'] = instances[0]['wl_socket']
    def ctl(*args):
        return subprocess.check_output(['/usr/bin/hyprctl', *args], text=True)
    def focus(workspace):
        ctl('dispatch', 'hl.dsp.focus({ workspace = ' + json.dumps(str(workspace)) + ' })')
    action = sys.argv[1]
    if action in ('left', 'right'):
        focus('r+1' if action == 'left' else 'r-1')
    elif action in ('up', 'launcher'):
        subprocess.run(['/usr/bin/omarchy-menu','toggle','apps'], check=True)
    else:
        subprocess.run(['/usr/bin/omarchy-menu', 'close'], check=True)
        state = Path(os.environ['XDG_RUNTIME_DIR'])/'deskflow-gesture-desktop.json'
        current = json.loads(ctl('activeworkspace','-j'))['id']
        saved = json.loads(state.read_text()) if state.exists() else {}
        if action == 'restore-desktop':
            if saved and current == saved.get('desktop'):
                focus(saved['previous'])
                state.unlink()
        elif current == saved.get('desktop'):
            if action != 'show-desktop':
                focus(saved['previous'])
                state.unlink()
        else:
            focus('empty')
            desktop = json.loads(ctl('activeworkspace','-j'))['id']
            state.write_text(json.dumps({'previous':current, 'desktop':desktop}))

if __name__ == '__main__':
    main()
